# ===========================================================================
# PatentGate - root environment template.  Copy to .env and fill in values.
# The agents (agent1..agent4, patent_search, report_agent, image_genration)
# read this file. The backend has its own backend/.env (see backend/.env.example).
# ===========================================================================

# --- LLM provider (provider-agnostic layer, see llm/config.py) --------------
# One of: openai | anthropic | gemini | openrouter | local
# The spec calls for Claude Sonnet 4.6 for agents 1-4 and the report agent.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
# Optional. Required for `local`; overrides the default for gemini/openrouter.
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=4096

# --- Per-agent overrides (optional) ----------------------------------------
# Any LLM_* key can be prefixed with an agent name to override it for that
# agent only. Agent keys: AGENT1, AGENT2, AGENT3, AGENT4, REPORT, IMAGE.
# AGENT1 also takes the product image (vision) when one is supplied.
# AGENT1_LLM_MODEL=claude-sonnet-4-6
# AGENT2_LLM_MODEL=claude-sonnet-4-6

# --- Image generation (Agent 4 before/after concepts, DALL-E 3) -----------
# Image generation is a different modality and uses the OpenAI Images API
# surface directly (also exposed by openrouter / gemini / local).
IMAGE_LLM_PROVIDER=openai
IMAGE_LLM_MODEL=dall-e-3
IMAGE_LLM_API_KEY=
# Falls back to OPENAI_API_KEY when IMAGE_LLM_API_KEY is unset.
# OPENAI_API_KEY=

# --- Patent search layer -------------------------------------------------
# All optional. With no keys the layer falls back to the credential-free
# Google Patents endpoint, then to concept-derived stubs.
PATENTSVIEW_API_KEY=
TAVILY_API_KEY=
PATENT_SEARCH_ENABLED=true
PATENT_SEARCH_ALLOW_SCRAPE=true
# PATENT_SEARCH_TIMEOUT=12

# --- Legacy fallbacks (still honoured if the LLM_* keys are unset) ---------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Provider examples:
#   Anthropic:   LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-4-6      LLM_API_KEY=sk-ant-...
#   OpenAI:      LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini            LLM_API_KEY=sk-...
#   Gemini:      LLM_PROVIDER=gemini      LLM_MODEL=gemini-2.0-flash       LLM_API_KEY=...
#   OpenRouter:  LLM_PROVIDER=openrouter  LLM_MODEL=openai/gpt-4o-mini     LLM_API_KEY=sk-or-...
#   Local:       LLM_PROVIDER=local       LLM_MODEL=llama3.1               LLM_BASE_URL=http://localhost:11434/v1
