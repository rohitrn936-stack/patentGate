# Root environment variables for PatentGate
# Copy this to .env and fill in the values

# OpenAI API Key (required for Agent 1)
OPENAI_API_KEY=

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Backend configuration (in backend/.env)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patentgate
# JWT_SECRET=dev-secret-key-for-local-testing-only
# FRONTEND_ORIGIN=http://localhost:3000
# AGENT1_SERVER_URL=http://localhost:8000

# Frontend configuration (in frontend/.env.local)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8080