# ---------------------------------------------------------------------------
# PatentGate backend configuration. Copy to backend/.env and fill in values.
# ---------------------------------------------------------------------------

# development | test | production  (production enforces a strong JWT_SECRET)
APP_ENV=development

# Database. SQLite works with no setup; use Postgres for anything real.
#   sqlite+aiosqlite:///./patentgate.db
#   postgresql+asyncpg://user:pass@host:5432/patentgate
DATABASE_URL=sqlite+aiosqlite:///./patentgate.db

# Auth. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# LLM provider (used by the in-process agents). See llm/config.py for the full
# scheme, including per-agent overrides such as AGENT1_LLM_PROVIDER.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
# LLM_BASE_URL=                 # for openrouter / gemini / local / self-hosted
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# Image generation for the Agent 4 before/after concepts (DALL-E 3).
IMAGE_LLM_PROVIDER=openai
IMAGE_LLM_MODEL=dall-e-3
IMAGE_LLM_API_KEY=
# OPENAI_API_KEY=              # used if IMAGE_LLM_API_KEY is unset

# Patent search layer (all optional; falls back to Google Patents then stubs).
PATENTSVIEW_API_KEY=
TAVILY_API_KEY=
PATENT_SEARCH_ENABLED=true
PATENT_SEARCH_ALLOW_SCRAPE=true

# Where generated concept images are written and served from (/media/...).
# MEDIA_ROOT=./media

# Run the agents in-process (default) or proxy Agent 1 to a separate server.
IN_PROCESS_AGENTS=true
AGENT1_SERVER_URL=http://localhost:8001

# Observability / limits
LOG_LEVEL=INFO
LOG_JSON=true
MAX_REQUEST_BYTES=8388608
RATE_LIMIT_ENABLED=true
# RATELIMIT_STORAGE_URI=memory://
