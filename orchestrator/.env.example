# Orchestrator configuration. Copy to .env and adjust as needed.

# Base URLs of each agent (documented defaults; ports are per-agent).
AGENT2_URL=http://127.0.0.1:8002
AGENT3_URL=http://127.0.0.1:8003
AGENT4_URL=http://127.0.0.1:8004

# Maximum number of refinement iterations (default 3).
MAX_ITERATIONS=3

# Per-request HTTP timeout in seconds (default 60).
HTTP_TIMEOUT=60